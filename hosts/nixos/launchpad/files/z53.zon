.{
    .listen = .{"127.0.0.1:53"},
    .zones = .{
        .{
            .suffix = ".",
            .hosts = .{ .ttl = 30 },
            .nodata = .{.AAAA},
            .upstreams = .{
                .{ .address = "1.1.1.1:853", .tls = .{ .server_name = "one.one.one.one" } },
                .{ .address = "1.0.0.1:853", .tls = .{ .server_name = "one.one.one.one" } },
                .{ .address = "8.8.8.8:853", .tls = .{ .server_name = "dns.google" } },
                .{ .address = "8.8.4.4:853", .tls = .{ .server_name = "dns.google" } },
            },
            .max_fails = 1,
            .health_check_interval_s = 5,
            .rotate = true,
        },
        .{
            .suffix = "tail45c3.ts.net.",
            .nodata = .{.AAAA},
            .max_depth = 1,
            .hosts = .{ .ttl = 30 },
            .upstreams = .{
                .{ .address = "100.100.100.100:53" },
            },
            .max_fails = 0,
            .cache = .{ .max_ttl_s = 30 },
        },
    },
}
