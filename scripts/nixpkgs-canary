#!/usr/bin/env bash
# nixpkgs-canary — move nixpkgs to the newest nixos-unstable commit this Mac
# still builds, and write it to flake.lock.
#
# Why this exists: `nix flake update` moves every input at once, and a broken
# bump costs a long build before you find out. This moves nixpkgs alone.
#
# How the search works:
#
#   1. Probe head. If it builds, that is the answer.
#   2. Otherwise walk back one day at a time until something builds. That
#      brackets the breakage between a known-good rev and a known-bad one.
#   3. Bisect the time inside that bracket, one API call per step and a build
#      only when the step lands on a commit never seen before. Probes there
#      rebuild just the derivations that failed earlier (the signature), not
#      the whole system.
#   4. Rebuild the winner's whole closure once to confirm, then pin it.
#
# It never activates anything. Every candidate is tested through
# --override-input, so a failed candidate costs disk, not state, and
# flake.lock only changes when a rev actually builds.
#
# Usage:
#   nixpkgs-canary                 # find the newest buildable rev and pin it
#   nixpkgs-canary <rev|date>      # pin one candidate (sha or YYYY-MM-DD)
#   nixpkgs-canary --eval-only ... # stage 1 only, fast signal, never pins
#   nixpkgs-canary --no-pin ...    # test only, leave flake.lock alone
#   nixpkgs-canary --days N        # walk-back window, default 14
#
# Env: HOST (default Matts-MacBook-Pro), FLAKE (default: this repo),
#      GITHUB_TOKEN (raises the API rate limit)
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOST=${HOST:-"Matts-MacBook-Pro"}
FLAKE=${FLAKE:-"."}
PIN=${PIN:-1}
DAYS=${DAYS:-14}
cd "$REPO"
ATTR="darwinConfigurations.\"$HOST\".system"
NIXPKGS=${NIXPKGS:-github:NixOS/nixpkgs}
GIT_URL=${GIT_URL:-https://github.com/NixOS/nixpkgs}
LOG=$(mktemp -t canary.XXXXXX)
trap 'rm -f "$LOG"' EXIT

# Derivations that broke a build, as name-version. Cheap probes rebuild only
# these at a candidate rev, which skips the expensive rest of the closure.
FAILSET=${FAILSET:-}
# rev -> verdict cache, so a commit is never built twice.
PROBES=${PROBES:-}
GOOD=""

# Probe state survives runs, so an interrupted search does not redo work.
STATE=""
if [[ -d $REPO/.git ]]; then STATE="$REPO/.git/nixpkgs-canary.state"; fi

die() { echo "error: $*" >&2; exit 1; }

api() {
  curl -fsS -H 'Accept: application/vnd.github+json' \
    ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} "$@"
}

# iso EPOCH — RFC 3339, understood by the GitHub API.
iso() {
  date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ
}

# epoch_of STRING — seconds since the epoch for a local date-time.
epoch_of() {
  date -u -j -f '%Y-%m-%d %H:%M:%S' "$1" +%s 2>/dev/null \
    || date -u -d "$1" +%s
}

head_rev() {
  git ls-remote "$GIT_URL" nixos-unstable 2>/dev/null | cut -f1 | head -1
}

# rev_at EPOCH — last commit on nixos-unstable at or before that unix time.
rev_at() {
  api "https://api.github.com/repos/NixOS/nixpkgs/commits?sha=nixos-unstable&until=$(iso "$1")&per_page=1" 2>/dev/null \
    | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d[0]["sha"] if d else "")' 2>/dev/null || true
}

# day_end N — unix time at the end of the day N days ago.
day_end() {
  python3 -c 'import datetime,sys; d=datetime.datetime.now(datetime.UTC)-datetime.timedelta(days=int(sys.argv[1])); print(int(d.replace(hour=23,minute=59,second=59).timestamp()))' "$1"
}

eval_only() {
  nix eval --raw "$FLAKE#$ATTR" --override-input nixpkgs "$NIXPKGS/$1" >/dev/null 2>&1
}

report() {
  local line
  line=$(nix build --dry-run "$FLAKE#$ATTR" --override-input nixpkgs "$NIXPKGS/$1" 2>&1 \
    | grep -E 'will be (fetched|built)' || true)
  echo "${line:-nothing to build}"
}

# plan REV — derivations a build of REV would still have to produce.
plan() {
  nix build --dry-run "$FLAKE#$ATTR" --override-input nixpkgs "$NIXPKGS/$1" 2>&1 \
    | grep -oE '/nix/store/[a-z0-9]{32}-[^ ]+\.drv' || true
}

# signature_drvs REV — plan entries whose name-version is in FAILSET.
signature_drvs() {
  local drvs base f d
  drvs=$(plan "$1")
  for f in $FAILSET; do
    while read -r d; do
      base=${d##*/}
      base=${base#*-}
      base=${base%.drv}
      # ^* makes nix build the derivation's outputs, not the .drv file itself.
      if [[ $base == "$f" ]]; then echo "$d^*"; fi
    done <<< "$drvs"
  done | sort -u
}

load_state() {
  local k v failset_env=$FAILSET
  [[ -n $STATE && -f $STATE ]] || return 0
  while IFS='=' read -r k v; do
    case $k in
      FAILSET) FAILSET=$v ;;
      PROBES) PROBES=$v ;;
    esac
  done < "$STATE"
  # An explicit FAILSET in the environment wins over the saved one.
  if [[ -n $failset_env ]]; then FAILSET=$failset_env; fi
}

save_state() {
  [[ -n $STATE ]] || return 0
  printf 'FAILSET=%s\nPROBES=%s\n' "$FAILSET" "$PROBES" > "$STATE"
}

record_failures() {
  local name
  while read -r name; do
    if [[ -z $name ]]; then continue; fi
    case " $FAILSET " in *" $name "*) ;; *) FAILSET="${FAILSET:+$FAILSET }$name" ;; esac
  done < <(awk '
    /Cannot build .\/nix\/store\// {
      name = $0
      sub(/.*\/nix\/store\/[a-z0-9]{32}-/, "", name)
      sub(/\.drv.*/, "", name)
      pending = name
      next
    }
    /builder failed/ { if (pending != "") { print pending; pending = "" } }
    /dependency failed/ { pending = "" }
  ' "$LOG" 2>/dev/null | sort -u)
  save_state
}

cached() {
  local pair
  for pair in $PROBES; do
    [[ ${pair%%:*} == "$1" ]] && { echo "${pair#*:}"; return 0; }
  done
  return 1
}

remember() {
  PROBES="${PROBES:+$PROBES }$1:$2"
  save_state
}

full_build() {
  nix build --no-link "$FLAKE#$ATTR" --override-input nixpkgs "$NIXPKGS/$1" >"$LOG" 2>&1
}

# probe REV — true when REV builds. Cheap while FAILSET entries exist.
probe() {
  local rev=$1 drvs verdict
  if verdict=$(cached "$rev"); then
    if [[ $verdict == 1 ]]; then echo "cached ok"; else echo "cached FAIL"; fi
    [[ $verdict == 1 ]]
    return
  fi
  if ! eval_only "$rev"; then
    echo "eval FAIL"
    remember "$rev" 0
    return 1
  fi
  if [[ -n $FAILSET ]]; then
    drvs=$(signature_drvs "$rev")
    if [[ -n $drvs ]]; then
      # shellcheck disable=SC2086
      if ! nix build --no-link $drvs >"$LOG" 2>&1; then
        record_failures
        echo "still broken"
        remember "$rev" 0
        return 1
      fi
      # Everything that broke before builds here. Verdict without paying for
      # the whole closure; confirm_full settles it at the end.
      echo "signature clean"
      remember "$rev" 1
      return 0
    fi
    # None of the old failures need building at this rev: they are either
    # absent or already realised. Good enough to keep searching; the winner
    # gets a full build before anything is pinned.
    echo "no matching failures"
    remember "$rev" 1
    return 0
  fi
  if full_build "$rev"; then
    echo "build ok"
    remember "$rev" 1
    return 0
  fi
  record_failures
  echo "build FAIL"
  remember "$rev" 0
  return 1
}

# bisect_epochs LO HI — newest good rev between two unix times.
bisect_epochs() {
  local lo=$1 hi=$2 mid rev
  while (( hi - lo > 1 )); do
    mid=$(( (lo + hi) / 2 ))
    rev=$(rev_at "$mid")
    if [[ -z $rev ]]; then
      hi=$mid
      continue
    fi
    printf '%-12s ' "${rev:0:10}"
    if probe "$rev"; then
      GOOD=$rev
      lo=$mid
    else
      hi=$mid
    fi
  done
}

find_rev() {
  local head rev i bad_epoch d
  head=$(head_rev); [[ -n $head ]] || die "could not resolve nixos-unstable head"
  printf 'head         '
  if probe "$head"; then GOOD=$head; return 0; fi

  for ((i=1; i<=DAYS; i++)); do
    d=$(day_end "$i")
    rev=$(rev_at "$d")
    if [[ -z $rev ]]; then continue; fi
    if [[ -n ${GOOD:-} && $rev == "$GOOD" ]]; then continue; fi
    if cached "$rev" >/dev/null; then continue; fi
    printf '%-12s ' "${rev:0:10}"
    if probe "$rev"; then
      GOOD=$rev
      echo "bracket: ${GOOD:0:10} good, head ${head:0:10} bad"
      bisect_epochs "$d" "$(date +%s)"
      return 0
    fi
  done
  die "nothing built in the last $DAYS days"
}

current_rev() {
  nix flake metadata "$FLAKE" --json 2>/dev/null \
    | python3 -c 'import json,sys; n=json.load(sys.stdin)["locks"]["nodes"]; print(n[n["root"]["inputs"]["nixpkgs"]]["locked"]["rev"])' 2>/dev/null \
    || true
}

pin() {
  local rev=$1 old
  if [[ $PIN -eq 0 ]]; then
    echo "not pinning (--no-pin); rev is $rev"
    return 0
  fi
  old=$(current_rev)
  nix flake lock --override-input nixpkgs "$NIXPKGS/$rev" >/dev/null
  if [[ -n $old && $old != "$rev" ]]; then
    echo "flake.lock: ${old:0:12} -> ${rev:0:12}"
  else
    echo "flake.lock: already at ${rev:0:12}"
  fi
  echo "candidates were judged on the packages that broke; just apply is the full build"
}

resolve() {
  local arg=$1
  if [[ $arg =~ ^[0-9a-f]{7,40}$ ]]; then echo "$arg"; return; fi
  if [[ $arg =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    rev_at "$(epoch_of "$arg 23:59:59")"
    return
  fi
  die "not a sha or YYYY-MM-DD: $arg"
}

load_state

cmd=${1:-}
while :; do
  case $cmd in
    --no-pin) PIN=0; shift; cmd=${1:-} ;;
    --days)   DAYS=${2:?--days needs a number}; shift 2; cmd=${1:-} ;;
    *) break ;;
  esac
done

case $cmd in
  --eval-only)
    shift
    rev=$(resolve "${1:-$(head_rev)}")
    eval_only "$rev" && { echo "eval ok: $rev"; report "$rev"; } || die "eval failed: $rev"
    ;;
  "" )
    find_rev
    echo
    echo "GOOD: $GOOD"
    report "$GOOD"
    pin "$GOOD"
    ;;
  -h|--help)
    sed -n '/^# Usage:/,/^set -euo/p' "${BASH_SOURCE[0]}" \
      | sed -e 's/^# \{0,1\}//' -e '/^set -euo/d'
    ;;
  *)
    rev=$(resolve "$cmd")
    echo "candidate: $rev"
    probe "$rev" || die "does not build: $rev"
    echo "GOOD: $rev"
    report "$rev"
    pin "$rev"
    ;;
esac
